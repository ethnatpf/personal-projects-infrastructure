services:
    prometheus:
        image: prom/prometheus:v3.15.1
        restart: unless-stopped
        command:
            - --config.file=/etc/prometheus/prometheus.yml
            - --storage.tsdb.path=/prometheus
            - --storage.tsdb.retention.time={{ prometheus_retention }}
            - "--log.level=warn"
        volumes:
            - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
            - prometheus_data:/prometheus
        networks:
            - monitoring
            - observability_shared

    grafana:
        image: grafana/grafana:13.2.5
        restart: unless-stopped
        ports:
            - "{{ grafana_tailscale_ip }}:3000:3000"
        environment:
            GF_SECURITY_ADMIN_USER: admin
            GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/grafana_admin_password
            GF_USERS_ALLOW_SIGN_UP: "false"
            GF_LOG_LEVEL: warn
        env_file:
            - ./grafana-alerting.env
        volumes:
            - grafana_data:/var/lib/grafana
            - ./grafana-provisioning:/etc/grafana/provisioning:ro
            - ./grafana-admin-password:/run/secrets/grafana_admin_password:ro
        networks:
            - monitoring
    node-exporter:
        image: prom/node-exporter:v1.12.1
        restart: unless-stopped
        command:
            - --path.rootfs=/host
            - --collector.textfile.directory=/textfile
        pid: host
        volumes:
            - /:/host:ro,rslave
            - /var/lib/node_exporter/textfile:/textfile:ro
        networks:
            - monitoring
    loki:
        image: grafana/loki:3.7.9
        restart: unless-stopped
        command:
            - -config.file=/etc/loki/loki.yml
            - -log.level=warn
        volumes:
            - ./loki:/etc/loki:ro
            - loki_data:/loki
        networks:
            - monitoring

    alloy:
        image: grafana/alloy:v1.21.3
        restart: unless-stopped
        user: "0"
        command:
            - run
            - --storage.path=/var/lib/alloy/data
            - /etc/alloy/config.alloy
        volumes:
            - ./alloy:/etc/alloy:ro
            - /var/run/docker.sock:/var/run/docker.sock:ro
            - alloy_data:/var/lib/alloy/data
            - /var/log/journal:/var/log/journal:ro
            - /run/log/journal:/run/log/journal:ro
            - /etc/machine-id:/etc/machine-id:ro
        depends_on:
            - loki
        networks:
            - monitoring
    tempo:
        image: "grafana/tempo:3.1.1"
        restart: unless-stopped
        command:
        - "-config.file=/etc/tempo/tempo.yml"
        - "-log.level=warn"
        volumes:
        - ./tempo:/etc/tempo:ro
        - tempo_data:/var/tempo
        networks:
        - monitoring

volumes:
  prometheus_data:
  grafana_data:
  loki_data:
  alloy_data:
  tempo_data:

networks:
  monitoring:
    driver: bridge
  observability_shared:
    name: observability_shared
    external: true
