discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "container_labels" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.container_labels.rules
  forward_to    = [loki.write.local.receiver]
}

loki.relabel "pbm_journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "pbm-(hourly|daily|cleanup_hourly|cleanup_daily)\\.service"
    action        = "keep"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

loki.source.journal "pbm_jobs" {
  path          = "/var/log/journal"
  max_age       = "24h"
  labels        = { service = "mongodb-backup-systemd" }
  relabel_rules = loki.relabel.pbm_journal.rules
  forward_to    = [loki.write.local.receiver]
}

loki.relabel "personal_project_deploy_journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "personal-project-deploy@.*\\.service"
    action        = "keep"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

loki.source.journal "personal_project_deploy_jobs" {
  path          = "/var/log/journal"
  max_age       = "24h"
  labels        = { service = "personal-project-deploy" }
  relabel_rules = loki.relabel.personal_project_deploy_journal.rules
  forward_to    = [loki.write.local.receiver]
}

loki.relabel "faro_logs" {
  forward_to = [loki.write.local.receiver]

  rule {
    source_labels = ["app_name"]
    target_label  = "service_name"
  }

  rule {
    action = "labeldrop"
    regex  = "app_name"
  }
}

faro.receiver "integrations_app_agent_receiver" {
  log_format = "json"

  server {
    listen_address            = "0.0.0.0"
    listen_port               = 12347
    max_allowed_payload_size  = "2MiB"

    rate_limiting {
      rate = 100
    }
  }

  sourcemaps {
    download_from_origins = ["https://immersion-tracker.ethnatpf.com"]
  }

  // Empty values copy the corresponding Faro payload fields into labels.
  extra_log_labels = { "kind" = "", "app_name" = "", "type" = "" }

  output {
    logs   = [loki.relabel.faro_logs.receiver]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = []
    logs    = []
    traces  = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    metrics = []
    logs    = []
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}
