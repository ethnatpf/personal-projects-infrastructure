apiVersion: 1

groups:
  - orgId: 1
    name: VPS
    folder: "{{ grafana_infrastructure_folder_uid }}"
    interval: 1m
    rules:
      - uid: vps-disk-usage
        title: VPS Disk Usage High
        condition: C
        for: 5m
        noDataState: NoData
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: VPS root filesystem usage exceeds 80%
          description: Root filesystem usage has exceeded 80% for 5 minutes.

        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 300
              to: 0
            model:
              refId: A
              expr: |
                100 * (
                  1 -
                  node_filesystem_avail_bytes{mountpoint="/",fstype!~"tmpfs|overlay"}
                  /
                  node_filesystem_size_bytes{mountpoint="/",fstype!~"tmpfs|overlay"}
                )
              instant: true
              range: false

          - refId: B
            datasourceUid: __expr__
            relativeTimeRange:
              from: 0
              to: 0
            model:
              type: reduce
              refId: B
              expression: A
              reducer: last

          - refId: C
            datasourceUid: __expr__
            relativeTimeRange:
              from: 0
              to: 0
            model:
              type: threshold
              refId: C
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [80]
