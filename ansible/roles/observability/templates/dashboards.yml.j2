apiVersion: 1

providers:
  - name: Infrastructure
    orgId: 1
    folder: Infrastructure
    folderUid: "{{ grafana_infrastructure_folder_uid }}"
    type: file
    disableDeletion: false
    allowUiUpdates: false
    updateIntervalSeconds: 10
    options:
      path: /etc/grafana/provisioning/dashboards/infrastructure
