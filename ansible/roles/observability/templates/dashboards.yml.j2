apiVersion: 1

providers:
  - name: Infrastructure
    orgId: 1
    folder: "{{ grafana_infrastructure_folder_name }}"
    type: file
    disableDeletion: false
    allowUiUpdates: false
    updateIntervalSeconds: 10
    options:
      path: /etc/grafana/provisioning/dashboards/infrastructure

  - name: Immersion_tracker
    orgId: 1
    folder: "{{ grafana_immersion_tracker_folder_name }}"
    type: file
    disableDeletion: false
    allowUiUpdates: false
    updateIntervalSeconds: 10
    options:
        path: /etc/grafana/provisioning/dashboards/immersion-tracker

  - name: MongoDB
    orgId: 1
    folder: "MongoDB"
    type: file
    disableDeletion: false
    allowUiUpdates: false
    updateIntervalSeconds: 10
    options:
        path: /etc/grafana/provisioning/dashboards/mongodb
