global:
  scrape_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: node
    static_configs:
      - targets:
          - node-exporter:9100

  - job_name: mongodb
    scrape_interval: 30s
    static_configs:
        - targets:
            - mongodb_exporter:9216


  - job_name: immersion-tracker-api
    metrics_path: /metrics
    authorization:
        type: Bearer
        credentials_file: /run/secrets/metrics_token
    static_configs:
        - targets: ["immersion_tracker_backend:4000"]
