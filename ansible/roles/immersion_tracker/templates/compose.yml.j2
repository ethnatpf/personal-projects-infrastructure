services:
  immersion_tracker_backend:
    image: "{{ immersion_tracker_backend_image }}"
    restart: unless-stopped
    env_file:
      - ./backend.env
    environment:
      AUTH_ISSUER_BASE_URL: https://auth.ethnatpf.com/
      AUTH_AUDIENCE: https://immersion-tracker-api.ethnatpf.com
      OTEL_SERVICE_NAME: immersion-tracker-api
      OTEL_EXPORTER_OTLP_TRACES_ENDPOINT: http://alloy:4318/v1/traces
      OTEL_SDK_DISABLED: false
      OTEL_EXPORTER_OTLP_TRACES_PROTOCOL: http/protobuf
      FARO_RECEIVER_URL: http://alloy:12347/collect

    networks:
      - mongodb_app
      - immersion_tracker
      - observability_shared
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:4000/health"]
      interval: 15s
      timeout: 10s
      retries: 3
      start_period: 10s

  immersion_tracker_frontend:
    image: "{{ immersion_tracker_frontend_image }}"
    restart: unless-stopped
    env_file:
      - ./frontend.env
    environment:
      APP_BASE_URL: https://immersion-tracker.ethnatpf.com
      API_URL: http://immersion_tracker_backend:4000
      AUTH0_DOMAIN: auth.ethnatpf.com
      AUTH0_AUDIENCE: https://immersion-tracker-api.ethnatpf.com
    networks:
      - immersion_tracker
      - proxy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/api/health"]
      interval: 15s
      timeout: 10s
      retries: 3
      start_period: 10s

networks:
  immersion_tracker: {}
  mongodb_app:
    name: mongodb_app
    external: true
  proxy:
    external: true
  observability_shared:
    name: observability_shared
    external: true
